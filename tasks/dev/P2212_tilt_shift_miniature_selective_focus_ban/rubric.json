        {
          "expr": "(() => { const hs=[\"hud-bandWidth\", \"hud-blurAmount\", \"hud-enabled\", \"hud-focusY\", \"hud-preset\", \"hud-saturation\"]; const all=Array.from(document.querySelectorAll('body *')); const text=(tag,value)=>all.some(el=>(!tag||el.tagName.toLowerCase()===tag)&&String(el.textContent||'').trim().toLowerCase().includes(value.toLowerCase())); return hs.some(raw=>{ const h=String(raw).trim(); if(!h)return false; try { if(document.querySelector(h))return true; } catch {} const id=h.replace(/^#/,''); if(/^[A-Za-z][\\w:.-]*$/.test(id)&&document.getElementById(id))return true; const quoted=h.match(/^(?:([a-z]+)\\s+)?(?:with\\s+)?text\\s+['\"]([^'\"]+)['\"]$/i)||h.match(/^([a-z]+)\\s+labeled\\s+['\"]([^'\"]+)['\"]$/i); if(quoted&&text((quoted[1]||'').toLowerCase(),quoted[2]))return true; const label=h.match(/^(.*?)(?:\\s+button|\\s+slider|\\s+panel)$/i); return label ? text('',label[1]) : text('',h); }); })()",
          "tier": "L0"
        }
